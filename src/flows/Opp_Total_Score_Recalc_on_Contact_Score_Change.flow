<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Email_on_Failure</name>
        <label>Email on Failure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>emailSimple</actionName>
        <actionType>emailSimple</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <stringValue>robee.pilgrim@greenstreet.com,nkaminski@greenstreet.com</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <elementReference>ttFaultSubject</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailBody</name>
            <value>
                <elementReference>ttFaultBody</elementReference>
            </value>
        </inputParameters>
        <nameSegment>emailSimple</nameSegment>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Contact_Id</name>
        <label>Add Contact Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContactIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Build_Contact_Ids.ContactId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Build_Contact_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Contact_Score</name>
        <label>Add Contact Score</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContactSum</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Contact_Score.Contact_Score__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contact_Score</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Open_Opp_Ids</name>
        <label>Add Open Opp and Account Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOpenOppIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Build_Ids.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varAccountIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Build_Ids.AccountId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Build_Ids</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_Opp_Id</name>
        <label>Add Opp Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOppIds</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Contact_OCRs.OpportunityId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Contact_OCRs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Add_opp_to_update_collection</name>
        <label>Add opp to update collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varOppsToUpdate</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Opps</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Opps</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Calc_New_Total</name>
        <label>Calc New Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varNewTotal</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varContactSum</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varNewTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varBoosters</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Score_Changed</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Reset_Sum</name>
        <label>Reset Sum</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varContactSum</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varBoosters</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Has_OCRs</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Boosters</name>
        <label>Set Boosters</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varBoosters</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Account_Boosters.Account_Score_Fit_Boosters__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Account_Boosters</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Opp_Total</name>
        <label>Set Opp Total</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Loop_Opps.Opp_Total_Score__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varNewTotal</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_opp_to_update_collection</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>Filter_Account_for_Opp</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Account for this Opp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Account_for_Opp</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>colAccounts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Account_for_Opp.Id</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_Opps.AccountId</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_Account_Boosters</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Filter_Contact_for_OCR</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter Contact for this OCR</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_Contact_for_OCR</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>colContacts</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_Contact_for_OCR.Id</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_OCR_Inner.ContactId</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_Contact_Score</targetReference>
        </connector>
    </collectionProcessors>
    <collectionProcessors>
        <name>Filter_OCRs_for_Opp</name>
        <elementSubtype>FilterCollectionProcessor</elementSubtype>
        <label>Filter OCRs for this Opp</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNextValueToReference>currentItem_Filter_OCRs_for_Opp</assignNextValueToReference>
        <collectionProcessorType>FilterCollectionProcessor</collectionProcessorType>
        <collectionReference>colAllOCRs</collectionReference>
        <conditionLogic>and</conditionLogic>
        <conditions>
            <leftValueReference>currentItem_Filter_OCRs_for_Opp.OpportunityId</leftValueReference>
            <operator>EqualTo</operator>
            <rightValue>
                <elementReference>Loop_Opps.Id</elementReference>
            </rightValue>
        </conditions>
        <connector>
            <targetReference>Loop_OCR_Inner</targetReference>
        </connector>
    </collectionProcessors>
    <decisions>
        <name>Any_OCRs</name>
        <label>Any OCRs?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No OCRs</defaultConnectorLabel>
        <rules>
            <name>Has_OCRs_Overall</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colAllOCRs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Build_Contact_Ids</targetReference>
            </connector>
            <label>Has OCRs</label>
        </rules>
    </decisions>
    <decisions>
        <name>Any_Updates</name>
        <label>Any Updates?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Nothing to Update</defaultConnectorLabel>
        <rules>
            <name>Has_Updates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varOppsToUpdate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Bulk_Update</targetReference>
            </connector>
            <label>Has Updates</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Account</name>
        <label>Has Account?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Calc_New_Total</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Account</defaultConnectorLabel>
        <rules>
            <name>Account_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colAccounts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Opps.AccountId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_Account_for_Opp</targetReference>
            </connector>
            <label>Account Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Contact_OCRs</name>
        <label>Has Contact OCRs?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No OCRs</defaultConnectorLabel>
        <rules>
            <name>Contact_OCRs_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colContactOCRs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Contact_OCRs</targetReference>
            </connector>
            <label>OCRs Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_OCRs</name>
        <label>Has OCRs?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Has_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No OCRs</defaultConnectorLabel>
        <rules>
            <name>OCRs_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colAllOCRs</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Filter_OCRs_for_Opp</targetReference>
            </connector>
            <label>OCRs Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Open_Opps</name>
        <label>Has Open Opps?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No Open Opps</defaultConnectorLabel>
        <rules>
            <name>Open_Opps_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colOpps</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_Build_Ids</targetReference>
            </connector>
            <label>Open Opps Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Score_Changed</name>
        <label>Score Changed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Opps</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unchanged</defaultConnectorLabel>
        <rules>
            <name>Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varNewTotal</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Loop_Opps.Opp_Total_Score__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Opp_Total</targetReference>
            </connector>
            <label>Changed</label>
        </rules>
    </decisions>
    <description>Async path, runs when Contact_Score__c changes. Finds the contact&apos;s OPEN opps via Opportunity Contact Role and recalculates Opp_Total_Score__c (sum of contact scores on each opp&apos;s contact roles + the opp account&apos;s Account_Score_Fit_Boosters__c), updating only opps whose total changed. Ends cleanly when the contact has no contact roles. No Get Records inside loops; failures email Robee and Nikki and never block the triggering save.</description>
    <environments>Default</environments>
    <interviewLabel>Opp Total Score - Recalc on Contact Score Change {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opp Total Score - Recalc on Contact Score Change</label>
    <loops>
        <name>Loop_Account_Boosters</name>
        <label>Loop Account Boosters</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_Account_for_Opp</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Set_Boosters</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Calc_New_Total</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Build_Contact_Ids</name>
        <label>Loop Build Contact Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>colAllOCRs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Contact_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Contacts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Build_Ids</name>
        <label>Loop Build Ids</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>colOpps</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Open_Opp_Ids</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_All_OCRs</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Contact_OCRs</name>
        <label>Loop Contact OCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>colContactOCRs</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Opp_Id</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Open_Opps</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Contact_Score</name>
        <label>Loop Contact Score</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_Contact_for_OCR</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Contact_Score</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Loop_OCR_Inner</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_OCR_Inner</name>
        <label>Loop OCR Inner</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Filter_OCRs_for_Opp</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Filter_Contact_for_OCR</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Account</targetReference>
        </noMoreValuesConnector>
    </loops>
    <loops>
        <name>Loop_Opps</name>
        <label>Loop Opps</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>colOpps</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Reset_Sum</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Any_Updates</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Accounts</name>
        <label>Get Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Opps</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Email_on_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>varAccountIds</elementReference>
            </value>
        </filters>
        <object>Account</object>
        <outputReference>colAccounts</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Account_Score_Fit_Boosters__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_All_OCRs</name>
        <label>Get All OCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Any_OCRs</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Email_on_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>In</operator>
            <value>
                <elementReference>varOpenOppIds</elementReference>
            </value>
        </filters>
        <object>OpportunityContactRole</object>
        <outputReference>colAllOCRs</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>OpportunityId</queriedFields>
        <queriedFields>ContactId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Contact_OCRs</name>
        <label>Get Contact OCRs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Contact_OCRs</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Email_on_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <object>OpportunityContactRole</object>
        <outputReference>colContactOCRs</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>OpportunityId</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Contacts</name>
        <label>Get Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Accounts</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Email_on_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>varContactIds</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputReference>colContacts</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Contact_Score__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Opps</name>
        <label>Get Open Opps</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Open_Opps</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Email_on_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>In</operator>
            <value>
                <elementReference>varOppIds</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsClosed</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>colOpps</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>AccountId</queriedFields>
        <queriedFields>Opp_Total_Score__c</queriedFields>
    </recordLookups>
    <recordUpdates>
        <name>Bulk_Update</name>
        <label>Bulk Update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Email_on_Failure</targetReference>
        </faultConnector>
        <inputReference>varOppsToUpdate</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Contact_Score__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Get_Contact_OCRs</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
