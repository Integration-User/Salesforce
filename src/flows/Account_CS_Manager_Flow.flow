<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Assign_CS_Rep_Gabby_Parker</name>
        <label>Assign CS Rep Gabby Parker</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Customer_Success_Rep_ID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Label.CS_Rep_ID</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Customer_Success_Rep__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Label.CS_Rep_Name</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_2</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_to_Jane_Lyle</name>
        <label>Assign CS Rep Jane Lyle</label>
        <locationX>314</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>$Record.Customer_Success_Rep_ID__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CS_Rep_ID_Jane_Lyle</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Customer_Success_Rep__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CS_Rep_Name_Jane</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>END_ELEMENT_2</targetReference>
        </connector>
    </assignments>
    <constants>
        <name>AM_Manager_Paul_Eager</name>
        <dataType>String</dataType>
        <value>
            <stringValue>005f4000002iUBpAAM</stringValue>
        </value>
    </constants>
    <constants>
        <name>AM_Owner_Taylor_King</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0055G000006mj36QAA</stringValue>
        </value>
    </constants>
    <constants>
        <name>CS_Rep_ID_Jane_Lyle</name>
        <dataType>String</dataType>
        <value>
            <stringValue>0055G000008Cg3xQAC</stringValue>
        </value>
    </constants>
    <constants>
        <name>CS_Rep_Name_Jane</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Jane Lyle</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_AM_Manager_Owner</name>
        <label>Check AM Manager + Owner</label>
        <locationX>314</locationX>
        <locationY>287</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AM_Owners_Taylor_Megan</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AM_Manager__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.AM_Manager</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.Account_Owner</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_CS_Rep_Gabby_Parker</targetReference>
            </connector>
            <label>AM Owners: Taylor/Megan</label>
        </rules>
        <rules>
            <name>AM_Owners_Taylor_Paul</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.AM_Manager__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AM_Manager_Paul_Eager</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AM_Owner_Taylor_King</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_to_Jane_Lyle</targetReference>
            </connector>
            <label>AM Owners: Taylor/Paul</label>
        </rules>
    </decisions>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>314</locationX>
        <locationY>587</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>Account - CS Manager Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - CS Manager Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_AM_Manager_Owner</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AM_Manager__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
