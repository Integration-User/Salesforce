    <status>Active</status>
    <textTemplates>
        <name>OrderSupportCaseDesc</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hi OTC Team,
{!$User.FirstName} {!$User.LastName} has requested changes on this opportunity https://greenstreetadvisors--dev3.sandbox.lightning.force.com/{!OLI_DataTable.firstSelectedRow.OpportunityId} under {!OLI_DataTable.firstSelectedRow.Product2.Name} Opportunity Line Item.
Changes:
New Start Date: {!New_Start_Date}
New End Date: {!New_End_Date}
New Caption: {!New_Caption}</text>
    </textTemplates>
    <textTemplates>
        <name>OTCCaseSubject</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Advertising Changes for Product: {!OLI_DataTable.firstSelectedRow.Product2.Name} under {!Get_Current_Opp.Name}</text>
    </textTemplates>
