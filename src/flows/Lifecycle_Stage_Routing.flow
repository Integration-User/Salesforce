<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Route_by_Score</name>
        <label>Route by Score</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Cold_default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Cold</defaultConnectorLabel>
        <rules>
            <name>High_Priority</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>85.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>High_Priority_branch</targetReference>
            </connector>
            <label>High Priority</label>
        </rules>
        <rules>
            <name>SQL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>75.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SQL_branch</targetReference>
            </connector>
            <label>SQL</label>
        </rules>
        <rules>
            <name>MQL</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>50.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>MQL_branch</targetReference>
            </connector>
            <label>MQL</label>
        </rules>
        <rules>
            <name>Warm</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Contact_Score__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>20.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Warm_branch</targetReference>
            </connector>
            <label>Warm</label>
        </rules>
    </decisions>
    <description>Record-triggered flow on Contact. Fires when Contact Score changes and sets Lifecycle Stage based on score thresholds: 85+ High Priority, 75-84 SQL, 50-74 MQL, 20-49 Warm, 0-19 Cold. Contact Score is written back from the Data Cloud engagement scoring model via a Data 360 Copy Field. Disqualified is set manually by Sales, not by this flow. Account Score dimension deferred to a later phase.</description>
    <environments>Default</environments>
    <interviewLabel>Lifecycle Stage Routing {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lifecycle Stage Routing</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Cold_default</name>
        <label>Cold (default) →</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Lifecycle_Stage__c</field>
            <value>
                <stringValue>Cold</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>High_Priority_branch</name>
        <label>High Priority branch →</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Lifecycle_Stage__c</field>
            <value>
                <stringValue>High Priority</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>MQL_branch</name>
        <label>MQL branch →</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Lifecycle_Stage__c</field>
            <value>
                <stringValue>MQL</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>SQL_branch</name>
        <label>SQL branch →</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Lifecycle_Stage__c</field>
            <value>
                <stringValue>SQL</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Warm_branch</name>
        <label>Warm branch →</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Lifecycle_Stage__c</field>
            <value>
                <stringValue>Warm</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Route_by_Score</targetReference>
        </connector>
        <filterFormula>  AND(
    NOT(ISPICKVAL({!$Record.Lifecycle_Stage__c}, &quot;Disqualified&quot;)),
    NOT({!$Record.Disqualified__c}),
    OR(
      AND(ISNEW(), NOT(ISBLANK({!$Record.Contact_Score__c}))),
      ISCHANGED({!$Record.Contact_Score__c})
    )
  )</filterFormula>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
