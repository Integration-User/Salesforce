<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Skip_or_Tag</name>
        <label>Skip or Tag</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Tell_Us_About_Your_Needs_update</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Tag</defaultConnectorLabel>
        <rules>
            <name>Skip</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Dallas_Campaign_Member</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Tell_Us_About_Your_Needs__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>Dallas Event Oct 13-14</stringValue>
                </rightValue>
            </conditions>
            <label>Skip</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>fxDallasNote</name>
        <dataType>String</dataType>
        <expression>&quot;Dallas Event Oct 13-14 In-Person Meeting Request&quot; &amp;
IF(ISBLANK({!$Record.Tell_Us_About_Your_Needs__c}), &quot;&quot;,
   &quot; | &quot; &amp; {!$Record.Tell_Us_About_Your_Needs__c})</expression>
    </formulas>
    <interviewLabel>Dallas Event Oct 13-14 In-Person Meeting Requests {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Dallas Event Oct 13-14 In-Person Meeting Requests</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Dallas_Campaign_Member</name>
        <label>Get Dallas Campaign Member</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Skip_or_Tag</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CampaignId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>701Vy000025J5T8IAK</stringValue>
            </value>
        </filters>
        <filters>
            <field>ContactId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>CampaignMember</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Tell_Us_About_Your_Needs_update</name>
        <label>Tell Us About Your Needs update</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Tell_Us_About_Your_Needs__c</field>
            <value>
                <elementReference>fxDallasNote</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Dallas_Campaign_Member</targetReference>
        </connector>
        <filterFormula>AND(
  {!$Record.Form_Key__c} = &quot;demo-request-us&quot;,
  OR(
    ISCHANGED({!$Record.Form_Key__c}),
    ISCHANGED({!$Record.Submission_Page_URL__c})
  )
)</filterFormula>
        <object>Contact</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
