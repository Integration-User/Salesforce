<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>true</areMetricsLoggedToDataCloud>
    <constants>
        <name>SDOName</name>
        <dataType>String</dataType>
        <value>
            <stringValue>1</stringValue>
        </value>
    </constants>
    <dataSpace>default</dataSpace>
    <description>Always mark Inbound checkbox to true, set the stage to Open, assign to CRM Integration user, and set the SDO Name to 1 as we already have a flow to revise it automatically when created.</description>
    <environments>Default</environments>
    <interviewLabel>Demo Request - CA Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Demo Request - CA Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Demo_Request_Opportunity</name>
        <label>Create Demo Request Opportunity</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Inbound__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>SDOName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <stringValue>0055G0000071oXH</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>StageName</field>
            <value>
                <stringValue>Open</stringValue>
            </value>
        </inputAssignments>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordUpdates>
        <name>Update_Contact_w_Demo_Form_Data</name>
        <label>Update Contact w/Demo Form Data</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Create_Demo_Request_Opportunity</targetReference>
        </connector>
        <inputAssignments>
            <field>Lead_Type__c</field>
            <value>
                <stringValue>Demo Request</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Marketing_Product_of_Interest__c</field>
            <value>
                <elementReference>$Input.Marketing_Product_of_Interest__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Submission_Page_URL__c</field>
            <value>
                <elementReference>$Input.Submission_Page_URL__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Tell_Us_About_Your_Needs__c</field>
            <value>
                <elementReference>$Input.Tell_Us_About_Your_Needs__c</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Contact_w_Demo_Form_Data</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Form_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>demo-request-ca</stringValue>
            </value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>IndivRelatedRecord</triggerType>
    </start>
    <status>Draft</status>
</Flow>
