    <decisions>
        <name>Email_by_Product</name>
        <label>Email by Product</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Opportunities</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>US_News</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Opportunities.Products__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Asset-Backed Alert</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Opportunities.Products__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Commercial Mortgage Alert</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Opportunities.Products__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Real Estate Alert</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_US_EM_1</targetReference>
            </connector>
            <label>US News</label>
        </rules>
        <rules>
            <name>EU_News</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Opportunities.Products__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Green Street News: Europe</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_EU_EM_1</targetReference>
            </connector>
            <label>EU News</label>
        </rules>
    </decisions>
