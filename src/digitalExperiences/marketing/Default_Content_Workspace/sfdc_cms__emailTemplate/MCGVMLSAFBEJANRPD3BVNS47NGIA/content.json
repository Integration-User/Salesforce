ly:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 20px 20px\"><div id=\"hs_cos_wrapper_module_17630454800055\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><div id=\"hs_cos_wrapper_module_17630454800055_\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_rich_text\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"rich_text\"><h1 style=\"margin:0; font-size:24px; line-height:115%; text-align:center; font-family: 'Rethink Sans', Arial; font-weight:normal\" align=\"center\"><span style=\"color: #ffffff;\">Activate Your <span style=\"font-weight: normal;\">Green Street News</span> Account</span></h1></div></div></td></tr></tbody></table>\n</div>\n<!--[if gte mso 9]></table><![endif]-->\n<!--[if (mso)|(IE)]></td><![endif]-->\n\n    <!--[if (mso)|(IE)]></tr></table><![endif]-->\n\n    </div>\n   \n  </div>\n  <div id=\"section_1763767068403\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px\">\n\n    \n    \n      <div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#FBFBFA; padding-top:20px\" bgcolor=\"#FBFBFA\">\n    \n    <!--[if (mso)|(IE)]>\n      <table align=\"center\" style=\"width:600px;\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"600\" bgcolor=\"#FBFBFA\">\n      <tr style=\"background-color:#FBFBFA;\">\n    <![endif]-->\n\n    <!--[if (mso)|(IE)]>\n  <td valign=\"top\" style=\"width:600px;padding-top:20px;\">\n<![endif]-->\n<!--[if gte mso 9]>\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px\">\n<![endif]-->\n<div id=\"column_1763767068403_0\" class=\"hse-column hse-size-12\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"\" style=\"\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:5px 30px 15px\"><div id=\"hs_cos_wrapper_module_176304494652912\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><div id=\"hs_cos_wrapper_module_176304494652912_\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_rich_text\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"rich_text\"><p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331;\">Hi Valued Client,</span></p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"> </p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331;\">Following up to make sure you're all set on Green Street News Canada.</span></p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"> </p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331;\">If you haven't yet activated your account, look for the earlier email from Green Street with your secure login link — or contact our Client Support team at <span style=\"font-weight: bold;\">clientsupport&#64;greenstreetnews.com</span> and we'll help get you set up right away. </span></p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"> </p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331;\">Once you're logged in, you'll have full access to exclusive, subscriber-only stories here: <span style=\"color: #49b065;\"><a href=\"https://greenstreetnews.com/canada/\" style=\"color:#49b065\" rel=\"noopener noopener noreferrer\" data-hs-link-id=\"0\" data-hs-link-id-v2=\"cgp9xtrU\" target=\"_blank\">Green Street News: Canada</a></span></span></p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"> </p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331;\">Please don't hesitate to reach out if you have any questions we can assist with. </span></p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"> </p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331;\">Best,</span></p>\n<p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331;\">Green Street</span></p></div></div></td></tr></tbody></table>\n</div>\n<!--[if gte mso 9]></table><![endif]-->\n<!--[if (mso)|(IE)]></td><![endif]-->\n\n    <!--[if (mso)|(IE)]></tr></table><![endif]-->\n\n    </div>\n   \n  </div>\n  <div id=\"section_17640038514473\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px\">\n\n    \n    \n      <div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#FBFBFA\" bgcolor=\"#FBFBFA\">\n    \n    <!--[if (mso)|(IE)]>\n      <table align=\"center\" style=\"width:600px;\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"600\" bgcolor=\"#FBFBFA\">\n      <tr style=\"background-color:#FBFBFA;\">\n    <![endif]-->\n\n    <!--[if (mso)|(IE)]>\n  <td valign=\"top\" style=\"width:600px;\">\n<![endif]-->\n<!--[if gte mso 9]>\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px\">\n<![endif]-->\n<div id=\"column-1764003851447-0\" class=\"hse-column hse-size-12\">\n  <div id=\"hs_cos_wrapper_module_17640038514472\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><!-- OUTERMOST WRAPPER -->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellsp