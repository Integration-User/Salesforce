e=\"padding:0px 0px 0px 0px;\">\n               <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" role=\"presentation\" style=\"min-width:100%;\">\n                <tbody>\n                 <tr>\n                  <td class=\"darkTarget\" style=\"padding:0px 0px 0px 0px;border-color:#0d4041;background-color:#ffffff;color:#162331;background-size:cover;background-position:center center;background-repeat:no-repeat;\">\n                   <table class=\"responsive-container\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" role=\"presentation\" style=\"min-width:100%;\">\n                    <tbody>\n                     <tr>\n                      <td class=\"sfdc-cms-column\" align=\"center\" valign=\"middle\" width=\"100.0%\">\n                       <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" role=\"presentation\" style=\"max-width:100%;\">\n                        <tbody>\n                         <tr>\n                          <td style=\"padding:0px 0px 0px 0px;\">\n                           <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" role=\"presentation\" style=\"min-width:100%;\">\n                            <tbody>\n                             <tr>\n                              <td class=\"\" style=\"padding:16px 16px 16px 16px;border-color:#0d4041;background-color:#0d4041;color:#162331;background-image:url('https://info.greenstreet.com/hubfs/wave-bg-1.png');background-size:cover;background-position:center center;background-repeat:no-repeat;\">\n                              <table cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" role=\"presentation\" style=\"min-width: 100%;border-color:#0d4041;color:#98f387;font-family:'Arial','Helvetica','sans-serif';font-size:16px;\">\n                              <tbody>\n                              <tr>\n                              <td style=\"padding:20px 0px 10px 0px;mso-line-height-rule:exactly; line-height:150%;\">\