background-color:#fff !important} }\n@media only print, only screen and (max-width:639px){ #section_17685658430553 .hse-column-container{background-color:#0d4040 !important}\n}\n@media only print, only screen and (max-width:639px){.hse-body-wrapper-td{padding-bottom:20px !important}\n#section_17925093131173 .hse-column-container{padding-top:0px !important;padding-bottom:0px !important}\n#section_17925093131173 .hse-column-container{background-color:#fff !important} }\na[x-apple-data-detectors]{color:inherit !important;text-decoration:none !important;font-size:inherit !important;font-family:inherit !important;font-weight:inherit !important;line-height:inherit !important}\na{text-decoration:underline}p{margin:0}body{-ms-text-size-adjust:100%;-webkit-text-size-adjust:100%;-webkit-font-smoothing:antialiased}\ntable{border-spacing:0;mso-table-lspace:0;mso-table-rspace:0}table,td{border-collapse:collapse}\nimg{-ms-interpolation-mode:bicubic}p,a,li,td,blockquote{mso-line-height-rule:exactly}\n</style>\n</head>\n<body bgcolor=\"#ffffff\" style=\"margin:0 !important; padding:0 !important; font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word\">\n<div style=\"display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0px;max-width:0px;opacity:0;overflow:hidden;\" lang=\"en\">Green Street's Commercial Real Estate Forum: Australia 2026 - Where Capital Meets Opportunity &#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;&#847;&zwnj;&nbsp;</div>\n\n<div class=\"hse-body-background\" lang=\"en\" style=\"background-color:#ffffff\" bgcolor=\"#ffffff\">\n<table role=\"presentation\" class=\"hse-body-wrapper-table\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:0; padding:0; width:100% !important; min-width:320px !important; height:100% !important\" width=\"100%\" height=\"100%\">\n<tbody><tr>\n<td class=\"hse-body-wrapper-td\" valign=\"top\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding-top:20px; padding-bottom:20px\">\n\n<!-- SECTION 1: HERO IMAGE -->\n<div id=\"section-0\" class=\"hse-section hse-section-first\" style=\"padding-left:10px; padding-right:10px\">\n<div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#FFFFFF\" bgcolor=\"#FFFFFF\">\n<div id=\"column-0-0\" class=\"hse-column hse-size-12\">\n<table class=\"hse-image-wrapper\" role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody>\n<tr>\n<td class=\"hs_padded\" align=\"center\" valign=\"top\" style=\"font-family:Arial, sans-serif; color:#23496d; word-break:break-word; text-align:center; padding:10px 20px; font-size:0px\">\n<a href=\"https://events-awards.greenstreet.com/event/crefaustralia2026/summary/?utm_source=hubspot&amp;utm_medium=prospect-list&amp;utm_campaign=CRE-AUS2026&amp;utm_term=au&amp;utm_content=email-1\" target=\"_blank\" style=\"color:#00a4bd\">\n<img alt=\"Event (Australia CRE, November 2026) MEET THE TEAM\" src=\"https://info.greenstreet.com/hs-fs/hubfs/Event%20(Australia%20CRE%2c%20November%202026)%20MEET%20THE%20TEAM.png?width=1120&amp;upscale=true&amp;name=Event%20(Australia%20CRE%2c%20November%202026)%20MEET%20THE%20TEAM.png\" style=\"outline:none; text-decoration:none; border:none; max-width:100%; font-size:16px\" width=\"560\" align=\"middle\">\n</a>\n</td>\n</tr>\n</tbody>\n</table>\n</div>\n</div>\n</div>\n\n<!-- SECTION 2: INTRO TEXT -->\n<div id=\"section_1736849603797\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px\">\n<div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#ffffff; padding-bottom:5px; padding-top:10px\" bgcolor=\"#ffffff\">\n<div id=\"column_1736849603797_0\" class=\"hse-column hse-size-12\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 20px\">\n<p style=\"text-align:center; font-size:16px; line-height:150%\" align=\"center\"><span style=\"color: #000000;\">We're looking forward to welcoming&nbsp;you to</span> <span style=\"color: #49b065;\"><a href=\"https://events-awards.greenstreet.com/event/crefaustralia2026/summary/?utm_source=hubspot&amp;utm_medium=prospect-list&amp;utm_campaign=CRE-AUS2026&amp;utm_term=au&amp;utm_content=email-1\" style=\"color:#49b065\" rel=\"noopener\" target=\"_blank\"><span style=\"font-weight: bold;\">Commercial Real Estate Forum: Australia 2026</span></a></span><span style=\"color: #000000;\">, taking place on<strong> 4 November&nbsp;</strong>at the Sheraton Grand Sydney Hyde Park&nbsp;in Sydney, Australia.</span></p>\n<p style=\"text-align:center; font-size:16px; line-height:150%\" align=\"center\">&nbsp;</p>\n<p style=\"text-align:center; font-size:16px; line-height:150%; font-weight:bold\" align=\"center\"><span style=\"color: #49b065;\"><a href=\"https://events-awards.greenstreet.com/event/crefaustralia2026/agenda/?utm_source=hubspot&amp;utm_medium=prospect-list&amp;utm_campaign=CRE-AUS2026&amp;utm_term=au&amp;utm_content=email-1\" style=\"font-weight:bold; color:#49b065\" rel=\"noopener\" target=\"_blank\">View the agenda &gt;&gt;</a></span></p>\n</td></tr></tbody></table>\n</div>\n</div>\n</div>\n\n<!-- SECTION 3: GREEN BANNER -->\n<div id=\"section_17685658430553\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px\">\n<div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#0D4040; padding-bottom:5px; padding-top:5px\" bgcolor=\"#0D4040\">\n<div id=\"column-1768565843055-0\" class=\"hse-column hse-size-12\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 35px\">\n<div style=\"line-height:175%; font-size:13px; text-align:left; direction:ltr; display:inline-block; vertical-align:top; width:100%\" align=\"left\">\n<div style=\"font-family:Arial; font-size:14px; font-weight:400; line-height:1.5; color:#3e464b; text-align:justify\" align=\"justify\">\n<p style=\"line-height:150%; font-weight:bold; font-size:16px; text-align:center\" align=\"center\"><span style=\"color: #ffffff; font-size: 18px;\">Meet the Green Street team on-site</span></p>\n</div>\n</div>\n</td></tr></tbody></table>\n</div>\n</div>\n</div>\n\n<!-- SECTION 4: BODY COPY + CTA -->\n<div id=\"section_1768565857892\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px\">\n<div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#ffffff; padding-bottom:10px; padding-top:10px\" bgcolor=\"#ffffff\">\n<div id=\"column_1768565857893_0\" class=\"hse-column hse-size-12\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 20px\">\n<div style=\"line-height:175%\"><span style=\"font-size: 16px; color: #000000;\">If you’re allocating capital, managing a fund, or developing in Australia, we’d love to show you the <span style=\"color: #49b065; font-weight: bold;\"><a href=\"https://www.greenstreet.com/?utm_source=hubspot&amp;utm_medium=prospect-list&amp;utm_campaign=CRE-AUS2026&amp;utm_term=au&amp;utm_content=email-1\" style=\"color:#49b065; font-weight:bold\" rel=\"noopener\" target=\"_blank\">Green Street Platform</a></span> in person and how it can help you:</span></div>\n<ul style=\"line-height:175%\">\n<li style=\"color: #000000;\">Track Australian listed real estate with independent REIT research and NAV analysis.</li>\n<li style=\"color: #000000;\">Put Australia in global context with research and data across the U.S., Europe, and Canada.</li>\n<li style=\"color: #000000;\">Pressure-test assumptions with institutional-grade data, with more to come.</li>\n<li style=\"color: #000000;\">And more coming soon.</li>\n</ul>\n<p style=\"text-align:center; font-size:16px; line-height:150%\" align=\"center\"><span style=\"color: #000000;\">Pre-book a personalised demo below. We'll be available throughout the event for in-person sessions tailored to your needs.</span></p>\n</td></tr></tbody></table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:5px 20px 20px\">\n<table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:separate;\">\n<tbody><tr>\n<td align=\"center\" valign=\"middle\" bgcolor=\"#49b065\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; border-radius:25px; cursor:auto; background-color:#49b065; mso-padding-alt:12px 30px\">\n<a href=\"https://www.greenstreet.com/request-a-demo/?utm_source=hubspot&amp;utm_medium=prospect-list&amp;utm_campaign=CRE-AUS2026&amp;utm_term=au&amp;utm_content=email-1\" target=\"_blank\" style=\"color:#00a4bd; font-size:16px; font-family:Arial, sans-serif; Margin:0; text-transform:none; letter-spacing:0px; text-decoration:none; padding:12px 30px; display:block\">\n<strong style=\"color:#ffffff;font-weight:bold;text-decoration:none;font-style:normal;\">Pre-book in-person demo</strong>\n</a>\n</td>\n</tr>\n</tbody></table>\n</td></tr></tbody></table>\n\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 20px\">\n<table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"vertical-align:top\" width=\"100%\">\n<tbody><tr>\n<td align=\"center\" style=\"font-family:Arial, sans-serif; color:#23496d; font-size:0; word-break:break-word\">\n<p style=\"font-size:1px;border-top:1px solid #999999;width:100%;margin:0 auto;\"></p>\n</td>\n</tr>\n</tbody></table>\n</td></tr></tbody></table>\n</div>\n</div>\n</div>\n\n<!-- SECTION 5: TEAM HEADSHOTS -->\n<div id=\"section_1792657951642\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px\">\n<div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#ffffff\" bgcolor=\"#ffffff\">\n\n<div id=\"column_1792657951642_0\" class=\"hse-column hse-size-3\">\n<table class=\"hse-image-wrapper\" role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n<tbody><tr>\n<td class=\"hs_padded\" align=\"center\" valign=\"top\" style=\"font-family:Arial, sans-serif; color:#23496d; word-break:break-word; text-align:center; padding:0px 20px; font-size:0px\">\n<img alt=\"Aaron Ling\" src=\"https://info.greenstreet.com/hs-fs/hubfs/Aaron%20Ling-1.png?width=220&amp;upscale=true&amp;name=Aaron%20Ling-1.png\" style=\"outline:none; text-decoration:none; max-width:100%; font-size:16px\" width=\"110\" align=\"middle\">\n</td>\n</tr></tbody>\n</table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 14px\">\n<p style=\"text-align:center; line-height:125%; font-size:16px\" align=\"center\"><span style=\"color: #000000;\"><strong><span style=\"font-family: Arial, sans-serif;\">Aaron Ling&nbsp;</span></strong></span></p>\n<p style=\"text-align:center; font-size:14px; line-height:125%\" align=\"center\"><span style=\"color: #000000;\">Head of EMEA &amp; APAC Sales</span></p>\n<p style=\"text-align:center; font-size:14px; line-heigh