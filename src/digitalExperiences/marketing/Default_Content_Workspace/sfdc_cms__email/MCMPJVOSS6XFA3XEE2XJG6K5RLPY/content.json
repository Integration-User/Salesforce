alt=\"Elizabeth Badcock\" src=\"https://info.greenstreet.com/hs-fs/hubfs/Liz.png?width=320&amp;upscale=true&amp;name=Liz.png\" style=\"outline:none; text-decoration:none; max-width:100%; font-size:16px\" width=\"160\" align=\"middle\">\n</td>\n</tr></tbody>\n</table>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 14px\">\n<p style=\"text-align:center; line-height:125%\" align=\"center\"><span style=\"color: #000000; font-size: 16px;\"><strong>Elizabeth Badcock</strong></span></p>\n<p style=\"text-align:center; line-height:125%\" align=\"center\"><span style=\"font-size: 14px; color: #000000;\">Business Development Manager, Events</span></p>\n</td></tr></tbody></table>\n</div>\n\n</div>\n</div>\n\n<!-- SECTION 6: HEADER BANNER + FOOTER -->\n<div id=\"section_17927478287235\" class=\"hse-section hse-section-last\" style=\"padding-left:10px; padding-right:10px\">\n<div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#ffffff\" bgcolor=\"#ffffff\">\n<div id=\"column-1792747828723-0\" class=\"hse-column hse-size-12\">\n\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" bgcolor=\"#F5F3E9\" style=\"background:#F5F3E9;\">\n<tbody><tr>\n<td align=\"center\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:0\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:720px; background:#F5F3E9;\">\n<tbody>\n<tr>\n<td style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:0\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" bgcolor=\"#0D4040\" style=\"height:92px; border-radius:0 0 16px 16px; bac