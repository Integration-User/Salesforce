px;\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"600\" bgcolor=\"#ffffff\">\n      <tr style=\"background-color:#ffffff;\">\n    <![endif]-->\n\n    <!--[if (mso)|(IE)]>\n  <td valign=\"top\" style=\"width:600px;\">\n<![endif]-->\n<!--[if gte mso 9]>\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px\">\n<![endif]-->\n<div id=\"column_1734012764837_2\" class=\"hse-column hse-size-12\">\n  <div id=\"hs_cos_wrapper_module_17340125932151\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><table class=\"hse-image-wrapper\" role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n  <tbody>\n    <tr>\n      <td align=\"center\" valign=\"top\" style=\"font-family:Arial, sans-serif; color:#23496d; word-break:break-word; text-align:center; padding:0px; font-size:0px\">\n        <a href=\"https://events-awards.greenstreet.com/event/infraglobalesgawards2026/home?utm_source=hubspot&amp;utm_medium=events-list&amp;utm_campaign=Infra-Global-ESG-Awards-2026&amp;utm_term=infrastructure&amp;utm_content=email-1\" target=\"_blank\" style=\"color:#00a4bd\" data-hs-link-id=\"0\" data-hs-link-id-v2=\"ZFjiqifk\">\n        <img alt=\"ESG 2026  London Winners (1)\" src=\"https://info.greenstreet.com/hs-fs/hubfs/ESG%202026%20%20London%20Winners%20(1).png?width=1200&amp;upscale=true&amp;name=ESG%202026%20%20London%20Winners%20(1).png\" style=\"outline:none; text-decoration:none; border:none; max-width:100%; font-size:16px\" width=\"600\" align=\"middle\">\n        </a>\n      </td>\n    </tr>\n  </tbody>\n</table></div>\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"\" style=\"\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px\"><div id=\"hs_cos_wrapper_module_17344375455048\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><div id=\"hs_cos_wrapper_module_17344375455048_\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_rich_text\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"rich_text\"><div style=\"text-align:center; line-height:125%; font-size:14px\" align=\"center\"><span style=\"color: #13525c;\"><strong><span style=\"font-size: 15px;\"><span style=\"color: #13525c;\">Infra Global ESG Awards</span> 2026 - Rest of World&nbsp;</span></strong></span></div>\n<p style=\"line-height:175%\"><span style=\"color: #13525c;\"> </span></p>\n<div style=\"text-align:center; line-height:125%; font-size:8px\" align=\"center\"><span style=\"color: #13525c;\">&nbsp;</span></div>\n<div style=\"text-align:center; line-height:125%; font-size:14px\" align=\"center\">\n<p style=\"line-height:125%\"><span style=\"color: #000000;\">&nbsp;Last night the infrastructure and energy community came together at the Sheraton Grand London Park Lane for the&nbsp;<a href=\"https://events-awards.greenstreet.com/event/infraglobalesgawards2026/home?utm_source=hubspot&amp;utm_medium=events-list&amp;utm_campaign=Infra-Global-ESG-Awards-2026&amp;utm_term=infrastructure&amp;utm_content=email-1\" rel=\"noopener\" style=\"color:#00a4bd\" data-hs-link-id=\"1\" data-hs-link-id-v2=\"aCkl+H/y\" target=\"_blank\"><span style=\"color: #13525c; font-weight: bold;\">Infra Global ESG Awards Rest of World</span></a>, marking another year of progress and impact in ESG.&nbsp;</span></p>\n<p style=\"line-height:125%\">&nbsp;</p>\n<p style=\"line-height:125%\"><span style=\"color: #000000;\">The awards recognised the organisations and individuals demonstrating excellence in ESG and helping to shape the future of infrastructure and energy. Bringing together senior figures from the industry, the ceremony highlighted the ambition and expertise behind this year’s standout achievements. The evening also offered a valuable opportunity to reconnect with peers, exchange perspectives and strengthen relationships within the sector.</span></p>\n<p style=\"color:#23496d; background-color:#ffffff; text-align:center; line-height:125%\" bgcolor=\"#ffffff\" align=\"center\"><span style=\"color: #000000;\">&nbsp;</span></p>\n<p style=\"color:#23496d; background-color:#ffffff; line-height:125%; text-align:center\" bgcolor=\"#ffffff\" align=\"center\"><span style=\"color: #000000;\">&nbsp;<span style=\"text-align: center; background-color: #ffffff;\">A big thank you to everyone who participated and congratulations to all of those who were shortlisted, with special applause for this year’s winners!</span>&nbsp;</span></p>\n</div></div></div></td></tr></tbody></table>\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"\" style=\"\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; padding:10px 20px\"><div id=\"hs_cos_wrapper_module_17811891767535\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:separate;\">\n    <tbody><tr>\n      <td align=\"center\" valign=\"middle\" bgcolor=\"#13525c\" style=\"font-family:Arial, sans-serif; font-size:15px; color:#23496d; word-break:break-word; border-radius:6px; cursor:auto; background-color:#13525c; mso-padding-alt:12px 18px\">\n        <a href=\"https://events-awards.greenstreet.com/event/infraglobalesgawards2026/rest-of-world\" target