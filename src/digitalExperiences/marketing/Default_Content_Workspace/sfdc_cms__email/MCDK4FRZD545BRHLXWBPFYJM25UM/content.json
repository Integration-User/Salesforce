right:10px; background-color:#FFFFFF\" bgcolor=\"#FFFFFF\">\n\n    \n      \n      <!--[if gte mso 9]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\" style=\"width:100%\" bgcolor=\"#FFFFFF\"><tbody><tr><td valign=\"top\"><![endif]-->\n    \n    \n      <div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto\">\n    \n    <!--[if (mso)|(IE)]>\n      <table align=\"center\" style=\"width:600px;\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n      <tr>\n    <![endif]-->\n\n    <!--[if (mso)|(IE)]>\n  <td valign=\"top\" style=\"width:600px;\">\n<![endif]-->\n<!--[if gte mso 9]>\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px\">\n<![endif]-->\n<div id=\"column-0-0\" class=\"hse-column hse-size-12\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"\" style=\"\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:16px; color:#1a1a1a; word-break:break-word; padding:20px 20px 34px\"><div id=\"hs_cos_wrapper_module-0-0-0\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><div id=\"hs_cos_wrapper_module-0-0-0_\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_rich_text\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"rich_text\"><h2 style=\"margin:0; font-family:Arial, sans-serif; color:#3c3c3c; font-size:14px; line-height:150%; text-align:left; font-weight:normal\" align=\"left\"><span style=\"color: #1a1a1a;\">Hello  ,</span></h2>\n<p style=\"font-size:14px; line-height:150%\">&nbsp;</p>\n<p style=\"font-size:14px; line-height:150%\">Hope you're doing well. I noticed you'll be at CREDA in Denver next week&nbsp;and wanted to reach out ahead of time. I'll be out there too and would love to grab 15 minutes if you're around.</p>\n<p style=\"font-size:14px; line-height:150%\"><br>I'm with Green Street's<span style=\"color: #0600ff;\"> <a href=\"https://www.greenstreet.com/products/advisory-services/\" style=\"color:#0600ff\" rel=\"noopener\" data-hs-link-id=\"0\" data-hs-link-id-v2=\"FIbMoLNF\" target=\"_blank\">Advisory Services Group</a></span>, separate from the research subscription you may be familiar with. We work directly with companies on bespoke engagements, strategic planning, portfolio and company valuations, niche sector analysis, transaction support, and IPO prep.</p>\n<p style=\"font-size:14px; line-height:150%\"><br>I'm free most of Monday (10/5) and Tuesday (10/6), before the forum meetings take over Wednesday. Happy to grab coffee at the espresso bar or work around whichever tours or sessions you've signed up for.</p>\n<p style=\"font-size:14px; line-height:150%\"><br>Would love to hear what your team is working through right now and compare notes on what we're seeing in the market. Let me know if either day works for you.</p>\n<p style=\"font-size:14px; line-height:150%\">&nbsp;</p>\n<p style=\"font-size:14px; line-height:150%\">&nbsp;</p>\n<p style=\"font-size:14px; line-height:150%\">Best,<br>Tyler</p>\n<p style=\"font-size:14px; line-height:150%\"><span style=\"color: #0600ff;\"><a href=\"mailto:tblue@greenstreet.com\" style=\"color:#0600ff\" rel=\"noopener\" data-hs-link-id=\"0\" data-hs-link-id-v2=\"6n+dbj3L\" target=\"_blank\">tblue@greenstreet.com</a></span></p></div></div></td></tr></tbody></table>\n</div>\n<!--[if gte mso 9]></table><![endif]-->\n<!--[if (mso)|(IE)]></td><![endif]-->\n\n    <!--[if (mso)|(IE)]></tr></table><![endif]-->\n\n    </div>\n   \n      <!--[if gte mso 9]></td></tr></table><![endif]-->\n   \n  </div>\n  <div id=\"section-1\" class=\"hse-section\" style=\"padding-left:10px; padding-right:10px; background-c