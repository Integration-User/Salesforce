ding:10px 30px 0px\"><div id=\"hs_cos_wrapper_module_17575230480404\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><div id=\"hs_cos_wrapper_module_17575230480404_\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_rich_text\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"rich_text\"><h3 style=\"font-size:17px; margin:0; line-height:150%; font-weight:bold; text-align:left\" align=\"left\"><span style=\"color: #02756e;\">About Green Street</span></h3></div></div></td></tr></tbody></table>\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" class=\"\" style=\"\"><tbody><tr><td class=\"hs_padded\" style=\"font-family:Arial, sans-serif; font-size:14px; color:#23496d; word-break:break-word; padding:0px 30px\"><div id=\"hs_cos_wrapper_module_17575230246063\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><div id=\"hs_cos_wrapper_module_17575230246063_\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_rich_text\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"rich_text\"><p style=\"line-height:150%; text-align:left\" align=\"left\"><span style=\"color: #162331; font-family: Arial, sans-serif;\"><span style=\"background-color: #fbfbfa;\">Green Street is the leading provider of actionable Real Assets research, news, data, analytics, and advisory services in North America, Europe, Australia, and Asia. For more than 40 years, the world’s largest institutional investors have relied on Green Street’s independent, unbiased insight to make better-informed investment decisions. Headquartered in Newport Beach, California, Green Street combines thought-leading research, proprietary data, and advanced analytics delivered through a modern platform. Learn more at </span><span style=\"background-color: #fbfbfa; color: #49b065;\"><a href=\"https://www.greenstreet.com/?utm_source=hubspot&amp;utm_medium=email-alerts&amp;utm_campaign=GreenStreetAI&amp;utm_term=AI&amp;utm_content=press-release\" style=\"color:#49b065\" data-hs-link-id=\"0\" data-hs-link-id-v2=\"tO2Jy6yz\" target=\"_blank\">greenstreet.com</a></span><span style=\"background-color: #fbfbfa;\">.</span></span></p></div></div></td></tr></tbody></table>\n</div>\n<!--[if gte mso 9]></table><![endif]-->\n<!--[if (mso)|(IE)]></td><![endif]-->\n\n    <!--[if (mso)|(IE)]></tr></table><![endif]-->\n\n    </div>\n   \n  </div>\n  <div id=\"section_17691218928363\" class=\"hse-section hse-section-last\" style=\"padding-left:10px; padding-right:10px\">\n\n    \n    \n      <div class=\"hse-column-container\" style=\"min-width:280px; max-width:600px; margin:0 auto; background-color:#FBFBFA\" bgcolor=\"#FBFBFA\">\n    \n    <!--[if (mso)|(IE)]>\n      <table align=\"center\" style=\"width:600px;\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"600\" bgcolor=\"#FBFBFA\">\n      <tr style=\"background-color:#FBFBFA;\">\n    <![endif]-->\n\n    <!--[if (mso)|(IE)]>\n  <td valign=\"top\" style=\"width:600px;\">\n<![endif]-->\n<!--[if gte mso 9]>\n  <table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:600px\">\n<![endif]-->\n<div id=\"column-1769121892836-0\" class=\"hse-column hse-size-12\">\n  <div id=\"hs_cos_wrapper_module_17691218928362\" class=\"hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module\" style=\"color: inherit; font-size: inherit; line-height: inherit;\" data-hs-cos-general-type=\"widget\" data-hs-cos-type=\"module\"><!-- OUTERMOST WRAPPER -->\n<table role=\"presentation\" width=\"100%\" cellpadd